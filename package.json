{
  "name": "pages-github-pull-request-target",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "generate:data": "bun scripts/generate-data.ts",
    "build": "vite build && tsgo -b",
    "check": "pnpm \"/^check:/\"",
    "check:app": "tsgo -b --noEmit",
    "check:scripts": "tsgo -p tsconfig.scripts.json --noEmit",
    "check:format": "oxfmt --check .",
    "format": "oxfmt .",
    "deploy": "pnpm build && wrangler deploy",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-virtual": "^3.14.23",
    "@vitejs/plugin-react": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "^0.74.0",
    "vite": "^8.3.5"
  },
  "packageManager": "pnpm@12.9.0"
}
